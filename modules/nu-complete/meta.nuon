{
  description: "The completion engine behind Tab: pipeline-aware, spec-driven"
  docs: "docs/reference/modules/nu-complete.md"
  # the engine itself; the specs it runs live in conf/completions.nu
  cost: 2ms
  # Eager by design: it owns the Tab menu, which must answer on the very first
  # keystroke of the first line.
  lazy: false
  requires: [
    { bin: "carapace", hard: false, why: "answers any slot a spec has no opinion on",
      install: { macos: "brew install carapace", linux: "see https://carapace.sh", windows: "scoop install carapace" } }
  ]
  knobs: {
    # To offer columns and values the engine runs the pipeline typed so far in
    # a subprocess. safe: only when every command in it is a read-only built-in
    # (ls, ps, open, where, ...; never an external, never rm/save/http). all:
    # your own commands too, with the config loaded (~80 ms instead of ~20).
    # off: never; Tab still filters and deduplicates.
    NU_COMPLETE_EVAL: { default: "safe", about: "run the typed pipeline to offer columns and values: safe (read-only built-ins only) | all (your commands too, ~80 ms) | off" }
  }
}
